// 1. Constraints & Indexes
CREATE CONSTRAINT unique_causal_node_id IF NOT EXISTS FOR (n:CausalNode) REQUIRE n.id IS UNIQUE;

// 2. Nodes Import with Dual Labels (:CausalNode and :NodeType)
MERGE (n:CausalNode:Symptom {id: 'symptom_bgp_down'}) ON CREATE SET n.label = 'BGP Neighbor Down', n.type = 'Symptom', n.description = 'BGP 피어 세션이 단절되어 라우팅 정보 교환이 중단됨', n.command = '', n.layer = '', n.details = '{"severity": "CRITICAL", "category": "BGP-Session"}';
