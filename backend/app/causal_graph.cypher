// =====================================================================
// Cisco IOS-XE Causal GraphDB - openCypher Definition
// Standard Neo4j & ArangoDB Graph Seed File
// =====================================================================

CREATE NODE TABLE IF NOT EXISTS CausalNode (id STRING, label STRING, type STRING, description STRING, details STRING, PRIMARY KEY (id));
CREATE REL TABLE IF NOT EXISTS Rel (FROM CausalNode TO CausalNode, relationship STRING, description STRING);

CREATE (:CausalNode {id: 'symptom_bgp_down', label: 'BGP Neighbor Down', type: 'Symptom', description: 'BGP 피어 세션이 단절되어 라우팅 정보 교환이 중단됨', details: '{"severity": "CRITICAL", "category": "BGP-Session"}'});
CREATE (:CausalNode {id: 'rc_bgp_auth_mismatch', label: 'BGP MD5 Password Mismatch', type: 'RootCause', description: 'BGP 피어 간 MD5 패스워드 불일치로 인한 TCP 세션 수립 실패', details: '{"protocol": "BGP", "layer": "L4-L7"}'});
CREATE (:CausalNode {id: 'rc_bgp_mtu_mismatch', label: 'Interface MTU Mismatch', type: 'RootCause', description: '피어 인터페이스 간 MTU 크기 불일치로 BGP 패킷 수신 시 세션 리셋', details: '{"protocol": "IP/Ethernet", "layer": "L2-L3"}'});
CREATE (:CausalNode {id: 'rc_interface_flapping', label: 'Physical Link Flapping', type: 'RootCause', description: '물리 인터페이스 불안정 또는 광 레벨 저하로 인한 링크 플래핑', details: '{"protocol": "Ethernet", "layer": "L1-L2"}'});
CREATE (:CausalNode {id: 'ver_check_bgp_summary', label: 'Verify BGP Summary', type: 'Verification', description: 'BGP 네이버 상태 및 Prefix 수신 카운터 확인', details: '{"method": "CLI Verification"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_bgp_summary', label: 'show ip bgp summary', type: 'Command', description: 'BGP 네이버 요약 정보 및 상태 확인', details: '{"command": "show ip bgp summary", "expected_state": "Established"}'});
CREATE (:CausalNode {id: 'ver_check_bgp_neighbors', label: 'Inspect BGP Neighbor Log', type: 'Verification', description: 'BGP 네이버 상세 에러 코드(Notification) 및 재연결 횟수 조사', details: '{"method": "Detailed CLI Log Check"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_bgp_neighbors', label: 'show ip bgp neighbors', type: 'Command', description: 'BGP 네이버 상세 정보 및 통계 확인', details: '{"command": "show ip bgp neighbors"}'});
CREATE (:CausalNode {id: 'ver_check_interface_status', label: 'Verify Interface Status', type: 'Verification', description: '물리 인터페이스 링크 및 프로토콜 상태(Up/Up) 확인', details: '{"method": "Interface State Inspection"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_int_brief', label: 'show ip interface brief', type: 'Command', description: '전체 인터페이스 IP 및 Line Status 확인', details: '{"command": "show ip interface brief"}'});
CREATE (:CausalNode {id: 'cmd_fix_bgp_auth', label: 'Remediation: Fix BGP Auth', type: 'Command', description: 'BGP 피어 MD5 패스워드 재설정 및 동기화', details: '{"type": "Remediation", "action": "hier_config_patch"}'});
CREATE (:CausalNode {id: 'cmd_fix_interface_mtu', label: 'Remediation: Set MTU 1500', type: 'Command', description: '인터페이스 MTU를 표준 1500으로 복구', details: '{"type": "Remediation", "action": "hier_config_patch"}'});
CREATE (:CausalNode {id: 'symptom_bgp_idle', label: 'BGP Stuck in Idle', type: 'Symptom', description: 'BGP 네이버가 Idle 또는 Idle (Admin) 상태에 멈춰 연결을 시작하지 못함', details: '{"severity": "CRITICAL", "category": "BGP-FSM"}'});
CREATE (:CausalNode {id: 'rc_bgp_no_route', label: 'No Route to Peer IP (IGP Unreachable)', type: 'RootCause', description: '라우팅 테이블에 피어 IP로 가는 경로(Static/IGP)가 없음', details: '{"protocol": "IP/Routing", "layer": "L3"}'});
CREATE (:CausalNode {id: 'rc_bgp_acl_filter', label: 'TCP Port 179 Blocked by ACL / CoPP', type: 'RootCause', description: '방화벽, 인터페이스 ACL 또는 CoPP에 의해 TCP 179번 포트 차단', details: '{"protocol": "TCP", "layer": "L4"}'});
CREATE (:CausalNode {id: 'rc_bgp_multihop_missing', label: 'eBGP Multihop Missing (TTL=1 Drop)', type: 'RootCause', description: '루프백이나 다중 홉 eBGP 피어링 시 TTL이 1로 제한되어 패킷 폐기', details: '{"protocol": "BGP", "layer": "L3"}'});
CREATE (:CausalNode {id: 'ver_check_peer_route', label: 'Verify Peer Route & Ping', type: 'Verification', description: '피어 IP로의 IP 경로 존재 여부 및 ICMP 통신 확인', details: '{"method": "Ping & Routing Table Check"}'});
CREATE (:CausalNode {id: 'cmd_ping_neighbor', label: 'ping <peer_ip>', type: 'Command', description: '피어 IP 도달 가능성(ICMP Ping) 점검', details: '{"command": "ping 192.168.100.12"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_route_peer', label: 'show ip route <peer_ip>', type: 'Command', description: '피어 IP 라우팅 엔트리 및 Next-Hop 확인', details: '{"command": "show ip route 192.168.100.12"}'});
CREATE (:CausalNode {id: 'ver_check_bgp_admin', label: 'Verify BGP Running Config', type: 'Verification', description: 'BGP 프로세스 내 neighbor shutdown 또는 ebgp-multihop 누락 확인', details: '{"method": "Config Inspection"}'});
CREATE (:CausalNode {id: 'cmd_show_run_bgp', label: 'show running-config | section router bgp', type: 'Command', description: 'BGP 전체 러닝 컨피그 확인', details: '{"command": "show running-config | section router bgp"}'});
CREATE (:CausalNode {id: 'cmd_fix_no_shutdown', label: 'Remediation: no neighbor shutdown', type: 'Command', description: 'BGP 피어 활성화 (no neighbor shutdown)', details: '{"type": "Remediation", "action": "cli_remediation"}'});
CREATE (:CausalNode {id: 'cmd_fix_ebgp_multihop', label: 'Remediation: ebgp-multihop 2', type: 'Command', description: 'eBGP 다중 홉 TTL 설정 (neighbor ebgp-multihop 2)', details: '{"type": "Remediation", "action": "hier_config_patch"}'});
CREATE (:CausalNode {id: 'cmd_fix_permit_tcp179', label: 'Remediation: Permit TCP Port 179', type: 'Command', description: 'ACL/CoPP에 BGP 포트(TCP 179) 통과 룰 추가', details: '{"type": "Remediation", "action": "cli_remediation"}'});
CREATE (:CausalNode {id: 'symptom_bgp_active', label: 'BGP Stuck in Active', type: 'Symptom', description: 'BGP 네이버가 TCP SYN 전송 후 응답을 받지 못해 Active 상태에 고착됨', details: '{"severity": "HIGH", "category": "BGP-FSM"}'});
CREATE (:CausalNode {id: 'rc_bgp_update_source_missing', label: 'Missing update-source Loopback0', type: 'RootCause', description: 'Loopback 피어링 시 TCP 패킷 소스 IP가 물리 인터페이스로 발송됨', details: '{"protocol": "BGP", "layer": "L3-L4"}'});
CREATE (:CausalNode {id: 'rc_bgp_as_mismatch', label: 'Remote-AS Number Mismatch', type: 'RootCause', description: '로컬 라우터와 대향 라우터 간 설정된 AS 번호가 일치하지 않음', details: '{"protocol": "BGP", "layer": "L7"}'});
CREATE (:CausalNode {id: 'rc_bgp_tcp_handshake_fail', label: 'TCP 3-Way Handshake Failure', type: 'RootCause', description: 'SYN-ACK가 도달하지 못하거나 소켓 바인딩 오류로 3-way 핸드셰이크 실패', details: '{"protocol": "TCP", "layer": "L4"}'});
CREATE (:CausalNode {id: 'ver_check_bgp_update_source', label: 'Verify TCP Socket & Source Binding', type: 'Verification', description: 'TCP 포트 179 연결 소켓의 Local IP / Foreign IP 바인딩 상태 점검', details: '{"method": "TCP Socket Inspection"}'});
CREATE (:CausalNode {id: 'cmd_show_tcp_brief', label: 'show tcp brief', type: 'Command', description: '활성 TCP 소켓 포트 및 상태(ESTAB/SYN_SENT) 확인', details: '{"command": "show tcp brief"}'});
CREATE (:CausalNode {id: 'cmd_fix_update_source', label: 'Remediation: neighbor update-source', type: 'Command', description: '피어에 update-source Loopback0 명시', details: '{"type": "Remediation", "action": "hier_config_patch"}'});
CREATE (:CausalNode {id: 'cmd_fix_remote_as', label: 'Remediation: Correct remote-as', type: 'Command', description: '대향 피어의 정확한 AS 번호로 수정', details: '{"type": "Remediation", "action": "cli_remediation"}'});
CREATE (:CausalNode {id: 'symptom_bgp_flapping', label: 'BGP Session Flapping', type: 'Symptom', description: 'BGP 세션이 연결된 후 주기적으로 Reset 또는 끊어짐을 반복함', details: '{"severity": "HIGH", "category": "BGP-Stability"}'});
CREATE (:CausalNode {id: 'rc_bgp_hold_timer_expired', label: 'Hold Timer Expired (Keepalive Drop)', type: 'RootCause', description: 'Keepalive 패킷이 제시간에 도착하지 않아 Hold Timer(기본 180초) 만료', details: '{"protocol": "BGP", "layer": "L7"}'});
CREATE (:CausalNode {id: 'rc_bgp_large_update_mtu', label: 'Large BGP Update Dropped by MTU', type: 'RootCause', description: 'Keepalive는 작아 통과하지만 많은 Prefix를 담은 Update 패킷이 MTU 초과로 드롭', details: '{"protocol": "TCP/IP", "layer": "L3-L4"}'});
CREATE (:CausalNode {id: 'rc_bgp_duplicate_router_id', label: 'Duplicate BGP Router-ID Conflict', type: 'RootCause', description: '두 라우터가 동일한 Router-ID를 사용하여 연결 시 세션 충돌 발생', details: '{"protocol": "BGP", "layer": "L7"}'});
CREATE (:CausalNode {id: 'ver_check_bgp_flap_history', label: 'Inspect Flap Notification Logs', type: 'Verification', description: 'BGP 에러 로그 및 Last Read/Write 통계 확인', details: '{"method": "Log & Notification Inspection"}'});
CREATE (:CausalNode {id: 'cmd_show_log_bgp', label: 'show log | include BGP', type: 'Command', description: 'BGP 세션 리셋 에러 메시지(NOTIFICATION) 필터링', details: '{"command": "show log | include BGP"}'});
CREATE (:CausalNode {id: 'cmd_fix_tcp_mss', label: 'Remediation: ip tcp adjust-mss 1360', type: 'Command', description: '인터페이스에 TCP MSS 자동 조정 적용하여 대형 Update 드롭 방지', details: '{"type": "Remediation", "action": "hier_config_patch"}'});
CREATE (:CausalNode {id: 'cmd_fix_bgp_router_id', label: 'Remediation: bgp router-id <unique>', type: 'Command', description: '고유한 루프백 IP로 BGP Router-ID 고정', details: '{"type": "Remediation", "action": "hier_config_patch"}'});
CREATE (:CausalNode {id: 'symptom_bgp_routes_inaccessible', label: 'BGP Routes Inaccessible / Invalid', type: 'Symptom', description: 'BGP 세션은 Established이나 수신된 경로의 Next-Hop이 유효하지 않아 라우팅 테이블(RIB) 미등록', details: '{"severity": "HIGH", "category": "BGP-Routing"}'});
CREATE (:CausalNode {id: 'rc_bgp_missing_next_hop_self', label: 'Unadvertised eBGP Subnet without next-hop-self', type: 'RootCause', description: 'eBGP 링크 대역이 내부 IGP(OSPF/IS-IS)에 network 선언이나 재분배(redistribute)되지 않았으며 iBGP next-hop-self도 누락된 경우에 발생 (OSPF/IGP로 이미 도달 가능한 경우 정상 동작)', details: '{"protocol": "BGP/iBGP", "layer": "L3"}'});
CREATE (:CausalNode {id: 'rc_bgp_next_hop_unreachable', label: 'Next-Hop IP Not Advertised in IGP', type: 'RootCause', description: 'Next-Hop 주소가 OSPF/IS-IS/Static 등 내부 라우팅에 광고되지 않아 재귀적 라우팅(Recursive Routing) 실패', details: '{"protocol": "IGP", "layer": "L3"}'});
CREATE (:CausalNode {id: 'rc_bgp_nexthop_missing_ospf', label: 'Next-Hop Unreachable via OSPF Underlay', type: 'RootCause', description: 'BGP Next-Hop 주소 대역이 OSPF 프로세스에 포함되지 않았거나 OSPF 네이버 인접성 다운', details: '{"protocol": "OSPF", "layer": "L3"}'});
CREATE (:CausalNode {id: 'rc_bgp_nexthop_missing_isis', label: 'Next-Hop Unreachable via IS-IS Underlay', type: 'RootCause', description: 'BGP Next-Hop 인터페이스에 IS-IS 미설정 또는 IS-IS Adjacency 부재로 경로 미등록', details: '{"protocol": "IS-IS", "layer": "L3"}'});
CREATE (:CausalNode {id: 'rc_bgp_nexthop_missing_static', label: 'Next-Hop Missing via Static Route', type: 'RootCause', description: 'BGP Next-Hop IP에 대한 정적 라우팅(ip route) 미설정 또는 넥스트홉 게이트웨이 유실', details: '{"protocol": "Static Routing", "layer": "L3"}'});
CREATE (:CausalNode {id: 'ver_check_ospf_underlay', label: 'Verify OSPF Underlay Route & Neighbor', type: 'Verification', description: 'OSPF 라우팅 테이블(show ip route ospf) 및 OSPF 네이버 인접성 확인', details: '{"method": "OSPF Underlay Verification"}'});
CREATE (:CausalNode {id: 'ver_check_isis_underlay', label: 'Verify IS-IS Underlay Adjacency & Database', type: 'Verification', description: 'IS-IS 인접성(show isis neighbors) 및 IS-IS 라우팅 테이블(show ip route isis) 확인', details: '{"method": "IS-IS Underlay Verification"}'});
CREATE (:CausalNode {id: 'ver_check_static_underlay', label: 'Verify Static Route to Next-Hop', type: 'Verification', description: '정적 라우팅 테이블(show ip route static) 내 Next-Hop 대상 경로 확인', details: '{"method": "Static Route Verification"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_bgp_prefix', label: 'show ip bgp', type: 'Command', description: '전체 BGP 테이블 경로 및 상태 확인', details: '{"command": "show ip bgp"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_route_nexthop', label: 'show ip route <next_hop>', type: 'Command', description: 'Next-Hop IP가 라우팅 테이블에 존재하는지 확인', details: '{"command": "show ip route 192.168.100.1"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_route_ospf', label: 'show ip route ospf', type: 'Command', description: 'OSPF로 학습된 언더레이 라우팅 테이블 확인', details: '{"command": "show ip route ospf"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_route_isis', label: 'show ip route isis', type: 'Command', description: 'IS-IS로 학습된 언더레이 라우팅 테이블 확인', details: '{"command": "show ip route isis"}'});
CREATE (:CausalNode {id: 'cmd_show_isis_neighbors', label: 'show isis neighbors', type: 'Command', description: 'IS-IS CLNS 인접성 상태(Level-1/Level-2) 확인', details: '{"command": "show isis neighbors"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_route_static', label: 'show ip route static', type: 'Command', description: '설정된 정적 경로(Static Route) 확인', details: '{"command": "show ip route static"}'});
CREATE (:CausalNode {id: 'cmd_fix_redistribute_or_declare_ospf', label: 'Remediation Option B: router ospf / redistribute connected (or network eBGP subnet)', type: 'Command', description: '외부 eBGP 링크 서브넷을 OSPF 프로세스에 선언하거나 redistribute connected하여 내부 iBGP 피어에 도달성 제공', details: '{"type": "Remediation", "action": "cli_remediation"}'});
CREATE (:CausalNode {id: 'cmd_fix_add_static_route', label: 'Remediation: ip route <next_hop> 255.255.255.255 <gw>', type: 'Command', description: 'BGP Next-Hop IP로 향하는 정적 경로(Static Route) 추가', details: '{"type": "Remediation", "action": "cli_remediation"}'});
CREATE (:CausalNode {id: 'symptom_ospf_exstart', label: 'OSPF Stuck in ExStart', type: 'Symptom', description: 'OSPF 네이버 상태가 DBD 교환 단계(ExStart/Exchange)에 고착됨', details: '{"severity": "HIGH", "category": "OSPF"}'});
CREATE (:CausalNode {id: 'rc_ospf_mtu_mismatch', label: 'OSPF MTU Mismatch', type: 'RootCause', description: '양단 인터페이스 MTU가 일치하지 않아 DBD 수신 실패', details: '{"protocol": "OSPF", "layer": "L3"}'});
CREATE (:CausalNode {id: 'ver_check_ospf_neighbor', label: 'Verify OSPF Neighbor', type: 'Verification', description: 'OSPF 인접 관계 상태 및 데드 타이머 점검', details: '{"method": "OSPF CLI Verification"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_ospf_neighbor', label: 'show ip ospf neighbor', type: 'Command', description: 'OSPF 네이버 상태 및 인터페이스 확인', details: '{"command": "show ip ospf neighbor"}'});
CREATE (:CausalNode {id: 'symptom_input_errors', label: 'Interface Input/CRC Errors', type: 'Symptom', description: '인터페이스 입력 에러 및 CRC 카운터 급증으로 패킷 드롭 발생', details: '{"severity": "MEDIUM", "category": "Hardware/L2"}'});
CREATE (:CausalNode {id: 'rc_duplex_mismatch', label: 'Duplex Mismatch (Half/Full)', type: 'RootCause', description: '대향 장비와의 Duplex 설정 불일치로 인한 Late Collision', details: '{"protocol": "Ethernet", "layer": "L2"}'});
CREATE (:CausalNode {id: 'ver_check_interface_counters', label: 'Inspect Interface Counters', type: 'Verification', description: '에러 카운터, Collision 및 Duplex 상태 점검', details: '{"method": "Detailed Interface Stats"}'});
CREATE (:CausalNode {id: 'cmd_show_interfaces', label: 'show interfaces', type: 'Command', description: '인터페이스 상세 카운터 및 Duplex 모드 점검', details: '{"command": "show interfaces GigabitEthernet1"}'});
CREATE (:CausalNode {id: 'cmd_fix_duplex_auto', label: 'Remediation: Auto Duplex/Speed', type: 'Command', description: '인터페이스를 speed auto 및 duplex auto 로 복구', details: '{"type": "Remediation", "action": "hier_config_patch"}'});
CREATE (:CausalNode {id: 'rc_interface_acl_blocked', label: 'Interface ACL (Access-List) Filter Blocking', type: 'RootCause', description: '인터페이스에 적용된 인바운드/아웃바운드 ACL(ip access-group)에 의해 라우팅 제어 패킷(TCP 179, OSPF 등) 또는 데이터 트래픽 차단', details: '{"protocol": "IP/Security", "layer": "Layer 3 (Security/Filter)", "osi_layer": "L3"}'});
CREATE (:CausalNode {id: 'rc_pbr_policy_override', label: 'Policy-Based Routing (PBR) Override / Misconfiguration', type: 'RootCause', description: '인터페이스에 설정된 PBR(ip policy route-map)이 일반 라우팅 테이블 조회를 우회하거나 Next-Hop을 비정상 경로/Null0로 강제 변경', details: '{"protocol": "IP/PolicyRouting", "layer": "Layer 3 (Policy Routing)", "osi_layer": "L3"}'});
CREATE (:CausalNode {id: 'ver_check_interface_acl_pbr', label: 'Verify Interface ACL & Policy Routing (OSI L3 Security/PBR)', type: 'Verification', description: '인터페이스 인바운드/아웃바운드 ACL 적용 상태 및 PBR(Policy Routing) 설정 점검', details: '{"layer": "OSI Layer 3", "method": "Interface Security & Policy Inspection"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_interface', label: 'show ip interface', type: 'Command', description: '인터페이스별 Inbound/Outbound ACL 및 Policy Routing(PBR) 적용 여부 확인', details: '{"command": "show ip interface", "osi_layer": "Layer 3"}'});
CREATE (:CausalNode {id: 'cmd_show_access_lists', label: 'show access-lists', type: 'Command', description: 'ACL 룰셋 정의 및 deny/permit 매칭 카운터 조사', details: '{"command": "show access-lists", "osi_layer": "Layer 3"}'});
CREATE (:CausalNode {id: 'cmd_show_ip_policy', label: 'show ip policy', type: 'Command', description: '활성화된 인터페이스별 PBR 정책 및 Route-Map 바인딩 확인', details: '{"command": "show ip policy", "osi_layer": "Layer 3"}'});
CREATE (:CausalNode {id: 'cmd_show_route_map', label: 'show route-map', type: 'Command', description: 'Route-Map 절(Clause) 매칭 조건 및 set next-hop 액션 분석', details: '{"command": "show route-map", "osi_layer": "Layer 3"}'});
CREATE (:CausalNode {id: 'cmd_fix_permit_acl_routing', label: 'Remediation: Permit Control Traffic in ACL', type: 'Command', description: 'ACL에 BGP(TCP 179) 또는 OSPF/트래픽 허용 룰 추가 (ip access-list extended <ACL> / permit tcp any any eq 179)', details: '{"type": "Remediation", "action": "hier_config_patch"}'});
