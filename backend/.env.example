# ==============================================================================
# Net-AIOps Studio Backend Environment Variables Template (.env.example)
# ==============================================================================

# LLM Provider Configuration (OpenAI Compatible)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Cisco IOS-XE Target Device Configuration
CISCO_HOST=192.168.10.1
CISCO_PORT=22
CISCO_USERNAME=admin
CISCO_PASSWORD=cisco_password
CISCO_ENABLE_PASSWORD=
CISCO_MOCK_MODE=true

# FastAPI Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=*
