# ==============================================================================
# Cisco IOS-XE Global Default Credentials (devices.env)
# 장비 접속 시 개별 설정이 없으면 이 기본정보를 따르며, 개별정보가 있다면 개별 설정이 우선합니다.
# ==============================================================================

DEFAULT_SSH_PORT=22
DEFAULT_SSH_USERNAME=admin
DEFAULT_SSH_PASSWORD=admin
DEFAULT_SSH_ENABLE_PASSWORD=admin
DEFAULT_MOCK_MODE=false
